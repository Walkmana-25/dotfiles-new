{{- $zellij := lookPath "zellij" -}}

{{- /* lookPathが相対パスを返した場合は使わない */ -}}
{{- if and $zellij (ne (printf "%.1s" $zellij) "/") -}}
  {{- $zellij = "" -}}
{{- end -}}

{{- /* PATH解決できない場合のOS/arch別フォールバック */ -}}
{{- if not $zellij -}}
  {{- if eq .chezmoi.os "darwin" -}}
    {{- if eq .chezmoi.arch "arm64" -}}
      {{- $zellij = "/opt/homebrew/bin/zellij" -}}
    {{- else if eq .chezmoi.arch "amd64" -}}
      {{- $zellij = "/usr/local/bin/zellij" -}}
    {{- end -}}
  {{- else if eq .chezmoi.os "linux" -}}
    {{- $zellij = "/usr/bin/zellij" -}}
  {{- end -}}
{{- end -}}

{{- if not $zellij -}}
  {{- fail "zellij not found" -}}
{{- end -}}

font-family = "Hack Nerd Font"

background-opacity = 0.85
background-blur = true
#term = xterm-256color

command = /bin/zsh -c "{{ $zellij }}"
# zellij / shell側でキーバインドを管理するため、Ghostty側ではkeybindを設定しない
