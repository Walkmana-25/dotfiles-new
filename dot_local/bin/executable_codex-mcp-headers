#!/bin/sh
# Codex http_headers_helper: lapis-mcp の Bearer トークンを 1Password から取得して JSON で返す
#
# 要件:
#   - OP_SERVICE_ACCOUNT_TOKEN 環境変数 (または 1Password ログイン済み CLI) が必要
#   - codex プロセスの PATH で op が解決できること
#     (GUI / IDE から起動する場合は PATH が絞られ op が見つからないことがあるので注意)
#
# 失敗時は非ゼロで終了する。codex 側はヘルパーの失敗を検知できるため、
# 空の Authorization ヘッダで MCP 起動を続けるより明示的に落とす方が安全。
set -eu

if ! token="$(op read 'op://TOKEN/lapis-mcp-1/credential')"; then
    echo "codex-mcp-headers: op read failed (1Password token not available)" >&2
    exit 1
fi

# 空トークンは異常系 (op が空文字列を返すケース) なので失敗させる
if [ -z "$token" ]; then
    echo "codex-mcp-headers: op read returned an empty token" >&2
    exit 1
fi

if command -v jq >/dev/null 2>&1; then
    # jq があれば JSON エスケープを任せる (scripts/setup_mac.sh の PACKAGES に含まれる)
    jq -n --arg t "$token" '{"Authorization": ("Bearer " + $t)}'
else
    # printf フォールバック: トークンに `"` や `\` が含まれない前提
    # (1Password credential の想定範囲では問題ない。jq 導入時は上の分岐が使われる)
    printf '{"Authorization": "Bearer %s"}' "$token"
fi
