# Codex 設定 — 個人PC版
#
# LiteLLM gateway 経由で GLM 等のモデルを使う構成 (OpenAI互換 /v1 + Responses API)。
# 構文の一次ソース: .opencode/research/codex-cli-config-spec.md
# 注意:
#   - { onepasswordRead } / { .chezmoi.homeDir } は chezmoi テンプレート式
#     (適用時に展開される)。壊さないこと。
#   - URL / API キーは chezmoi apply 時に onepasswordRead で一度だけ解決し、
#     平文展開する (Codex 起動時に 1Password CLI を実行しない)。
#   - キーをローテーションした場合は chezmoi apply の再実行が必要。
#   - TOML 仕様上、トップレベルキーは最初のテーブルヘッダより前に置くこと。

{{- $litKey := onepasswordRead "op://TOKEN/litellm/credential" -}}
{{- $litUrl := trimSuffix "/" (onepasswordRead "op://TOKEN/litellm/url") }}

model_provider = "litellm"
model = "autorouter/agent"
model_reasoning_effort = "high"
web_search = "live" # LiteLLM gateway 側のビルトイン Web Search (tools: [{"type":"web_search"}]) を Responses 経由で使う
auto_compact_token_limit = 120000
tool_output_token_limit = 4000
model_catalog_json = "{{ .chezmoi.homeDir }}/.codex/models.json"

approval_policy = "on-request"
sandbox_mode = "workspace-write"
approvals_reviewer = "auto_review"

# codex_apps (ChatGPT Apps 連携の組み込み MCP) は ChatGPT 認証 cookie ("biscuit")
# を要求するため、API キー運用では HTTP 451 no_biscuit_no_service で
# 必ず起動失敗する。使わないので無効化する。
[features]
apps = false
memories = true

[memories]
generate_memories = true
use_memories = true
disable_on_external_context = false

# LiteLLM gateway (lapis-dev)。wire_api = "responses" は gateway 側で
# chat 上流へのブリッジ対応済み。URL / キーは chezmoi apply 時に
# 一度だけ 1Password CLI で解決し平文展開。(Codex 起動時に op を実行しない)
[model_providers.litellm]
name = "litellm"
base_url = "{{ $litUrl }}/v1"
wire_api = "responses"
# ネイティブ standalone web search ツールを provider 能力として宣言する。
# (gateway 側が対応しない場合は検索実行時に失敗する)
supports_standalone_web_search = true

# API キーは chezmoi apply 時に一度だけ 1Password CLI で解決し平文展開。
# (Codex 起動時に op を実行しない)
experimental_bearer_token = "{{ $litKey }}"

# LiteLLM gateway リモート MCP server (streamable HTTP, /mcp)。
# server名 "mcps" は opencode 構成と整合するため維持。
# Bearer トークンは chezmoi apply 時に平文展開する。
# (Codex 起動時に 1Password CLI / helper を実行しない)
[mcp_servers.mcps]
url = "{{ $litUrl }}/mcp"
http_headers = { Authorization = "Bearer {{ $litKey }}" }

[agents]
enabled = true
default_subagent_model = "autorouter/agent"
default_subagent_reasoning_effort = "high"

[desktop]
followUpQueueMode = "steer"
usePointerCursors = false
toys-confetti-enabled = false
conversationDetailMode = "STEPS_COMMANDS"

[desktop.appearanceDarkChromeTheme]
accent = "#339cff"
accentSource = "chatgpt"
contrast = 60
ink = "#ffffff"
opaqueWindows = false
surface = "#181818"

[desktop.appearanceDarkChromeTheme.fonts]
code = '"Hack Nerd Font Mono"'

[desktop.appearanceDarkChromeTheme.semanticColors]
diffAdded = "#40c977"
diffRemoved = "#fa423e"
skill = "#ad7bf9"

[tui]
screen_reader_detection_done = true

[projects."/Users/yuuta/Documents/GitHub/devcontainer-features"]
trust_level = "trusted"

[projects."/Users/yuuta/Documents/GitHub/Floorp"]
trust_level = "trusted"

[projects."/Users/yuuta/.local/share/chezmoi"]
trust_level = "trusted"

[plugins."browser@openai-bundled"]
enabled = true

[plugins."unified-computer-use@openai-bundled"]
enabled = true

[plugins."computer-use@openai-bundled"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[marketplaces.openai-bundled]
source_type = "local"
source = "/Users/yuuta/.codex/.tmp/bundled-marketplaces/openai-bundled"

[marketplaces.openai-primary-runtime]
source_type = "local"
source = "/Users/yuuta/.cache/codex-runtimes/codex-primary-runtime/plugins/openai-primary-runtime"
