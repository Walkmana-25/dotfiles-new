/**
 * opencode config — 個人PC版 (v2ネイティブ形式 / opencode v2 バイナリ (brew) と共に)
 *
 * このファイルは v2ネイティブ記法で書かれている。主な v1 → v2 の対応:
 *   - "plugin" → "plugins" ({package, options} 形。context-mode は現行バイナリで
 *     ロード失敗するため撤去済み。詳細: .opencode/research/context-mode-replacement.md)
 *   - "provider" → "providers" ("options" → "settings")
 *   - "mcp" → "mcp": { "servers": {...} } ("enabled" → "disabled" 反転)
 *   - "agent" ブロック → 削除。agentごとの権限は
 *     private_dot_config/opencode/agents/*.md の permissions 配列に一元化済み
 *     (旧 "agent" ブロックの mcps_*: deny は各agent .md に移行済み。
 *      なお旧 "general": { "disable": true } は移行対象外 — 組込みagentの
 *      無効化が必要になったら agents エントリの disabled: true で代替すること)
 *   - 追加: "tool_output" でツール出力のコンテキスト保護を強化
 *
 * 詳細: .opencode/research/opencode-v2-native-config-spec.md
 * 注意: { onepasswordRead } は chezmoi テンプレート式 (適用時に展開される)。
 *       壊さないこと。
 **/
{{- $litKey := onepasswordRead "op://TOKEN/litellm/credential" -}}
{{- $litUrl := trimSuffix "/" (onepasswordRead "op://TOKEN/litellm/url") }}
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  // cc-safety-net: 破壊的コマンドの fail-closed ブロック (v2 は shell option で方言指定)
  "plugins": [{ "package": "cc-safety-net@latest", "options": { "shell": "posix" } }],
  "providers": {
    "zai-coding-plan": {
      "settings": {
        "apiKey": "{{ onepasswordRead "op://TOKEN/zai-api-key/credential" }}"
      }
    },
    // LiteLLM gateway (lapis-dev) — codex と同一の 1Password アイテム (vault TOKEN /
    // item litellm) を使う。URL / API キーは chezmoi apply 時に onepasswordRead で
    // 一度だけ解決し平文展開する (opencode 起動時に op を実行しない)。
    // キーローテーション時は chezmoi apply の再実行が必要。
    // 既定モデルにする場合は "model": "litellm/autorouter/agent" をトップレベルに置く。
    "litellm": {
      "name": "LiteLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{{ $litUrl }}/v1",
        "apiKey": "{{ $litKey }}"
      },
      // モデル一覧は codex の gateway カタログ (private_dot_codex/models.json /
      // scripts/gen-codex-model-catalog.py) と手動同期する。gateway 側の登録が
      // 変わったら codex カタログの再生成に合わせてここも編集すること。
      "models": {
        "autorouter/agent": { "name": "Auto Router Agent", "limit": { "context": 262144 } },
        "standard": { "name": "Standard", "limit": { "context": 1000000 } },
        "complex": { "name": "Complex", "limit": { "context": 1000000 } },
        "simple": { "name": "Simple", "limit": { "context": 262144 } },
        "batch": { "name": "Batch", "limit": { "context": 922000 } },
        "routing/zai/glm-5.3": { "name": "GLM 5.3", "limit": { "context": 1000000 } },
        "routing/zai/glm-5.3-flash": { "name": "GLM 5.3 Flash", "limit": { "context": 1000000 } },
        "iniad/gpt-6.1-sol": { "name": "GPT-6.1 Sol", "limit": { "context": 922000 } },
        "iniad/gpt-6-luna": { "name": "GPT-6 Luna", "limit": { "context": 922000 } },
        "iniad-claude/claude-sonnet-5-5": { "name": "Claude Sonnet 5.5", "limit": { "context": 1000000 } },
        "mistral/deepseek-v4-1-flash-1017": { "name": "DeepSeek V4.1 Flash", "limit": { "context": 1048576 } },
        "groq/gpt-oss-120b": { "name": "GPT-OSS 120B", "limit": { "context": 131072 } }
      }
    }
  },
  // ツール出力のコンテキスト保護: 既定50KB → 20KB に強化
  "tool_output": { "max_lines": 2000, "max_bytes": 20480 },
  "mcp": {
    "servers": {
      // server名 "mcps" は権限の mcps_* プレフィックスと整合するため維持
      "mcps": {
        "type": "remote",
        "url": "{{ onepasswordRead "op://TOKEN/lapis-mcp-1/url" }}",
        "headers": {
          "Authorization": "Bearer {{ onepasswordRead "op://TOKEN/lapis-mcp-1/credential" }}"
        },
        "disabled": false
      }
    }
  },
  // 組込み general agent の無効化 (旧v1 "agent": {"general": {"disable": true}} の移植)
  "agents": {
    "general": { "disabled": true }
  }
}
